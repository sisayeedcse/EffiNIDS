# Virtual environments
.venv/
venv/
env/
ENV/

# Python cache and build artifacts
__pycache__/
*.py[cod]
*$py.class
.Python
build/
dist/
*.egg-info/
*.egg

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# IDE, editor and tool configurations
.vscode/
.idea/
.kilo/
.DS_Store
Thumbs.db

# Test and tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local configuration and environment variables
.env
.env.*
!.env.example

# Large ML model artifacts (>100MB exceeds GitHub limits)
*.joblib
*.pkl
*.pickle
*.h5
results/*.joblib

# Large raw and processed datasets (exceeds recommended Git storage)
dataset/raw/*.xlsx
dataset/raw/*.csv
dataset/processed/*
!dataset/raw/.gitkeep
!dataset/processed/.gitkeep

# Preserve empty directory structure
!results/figures/.gitkeep
!results/logs/.gitkeep
!src/.gitkeep
